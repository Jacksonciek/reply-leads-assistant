{
  // Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reply-leads-assistant",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // React SPA built by Vite. Unknown paths fall back to index.html.
    "not_found_handling": "single-page-application",
    // API requests always reach the Worker first (never served as index.html).
    "run_worker_first": ["/api/*"]
  },
  // Optional KV (login rate limit + Google token cache). To enable: npx wrangler kv namespace create KV,
  // then add: "kv_namespaces": [{ "binding": "KV", "id": "<id>" }]
  "observability": { "enabled": true },
  "vars": {
    "SHEET_ID": "",
    "STORE": "supabase",
    // "true" = wajib login dengan ADMIN_PASSWORD. "false" = tanpa password (sementara).
    "REQUIRE_PASSWORD": "false",
    "GEMINI_MODEL": "gemini-flash-lite-latest",
    "GEMINI_FALLBACK_MODEL": "gemini-flash-latest"
  }
}
