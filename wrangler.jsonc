{
  // Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zeon-reply-generator",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // React SPA built by Vite. Unknown paths fall back to index.html.
    "not_found_handling": "single-page-application",
    // API requests always reach the Worker first (never served as index.html).
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    // Replace id after: npx wrangler kv namespace create KV
    { "binding": "KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "observability": { "enabled": true },
  "vars": {
    "SHEET_ID": "",
    "STORE": "sheets",
    "GEMINI_MODEL": "gemini-flash-lite-latest",
    "GEMINI_FALLBACK_MODEL": "gemini-flash-latest"
  }
}
